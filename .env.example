# ===== zenmux API =====
# 【生图用】调用模型的 API Key(sk-ai-v1-... 或 sk-ss-v1-...)
ZENMUX_API_KEY=sk-your-zenmux-key

# 【查余额用】Management API Key(sk-mg-v1-...),只读,用于在管理页显示服务器余额/订阅配额
# 在 ZenMux 控制台 > Management 创建。不填则管理页不显示服务器状态。
ZENMUX_MANAGEMENT_KEY=sk-mg-v1-your-management-key

# zenmux 接口基础地址(一般无需改)
# OpenAI 兼容协议基址(gpt-image-2 等走这里)
ZENMUX_OPENAI_BASE=https://zenmux.ai/api/v1
# Google/Gemini 兼容协议基址(banana 系列走这里)
ZENMUX_GEMINI_BASE=https://zenmux.ai/api/vertex-ai/v1
# 视频任务接口基址(doubao-seedance-2.0 走这里)。未文档化,默认同 ZENMUX_OPENAI_BASE,
# 如实测发现路径不同(如 /videos 返回 404)再单独配置。
ZENMUX_VIDEO_BASE=https://zenmux.ai/api/v1

# ===== MiniMax(音乐生成,直连,不经 zenmux) =====
# 在 MiniMax 开放平台申请。不填则音乐生成不可用。
# 大陆账号(https://platform.minimaxi.com)和海外账号(https://platform.minimax.io)是两套体系,key 不通用,
# 下面默认按大陆平台配置;如果你的 key 是海外账号申请的,把 MINIMAX_BASE 改成 https://api.minimax.io/v1。
MINIMAX_API_KEY=your-minimax-api-key
MINIMAX_BASE=https://api.minimaxi.com/v1

# ===== 可选兼容供应商 =====
# 在知识工作台的运行时供应商目录中启用后，可接入任意 OpenAI Images / Gemini 兼容端点。
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_BASE=https://api.openai.com/v1
# GEMINI_COMPATIBLE_API_KEY=
# GEMINI_COMPATIBLE_BASE=https://generativelanguage.googleapis.com/v1beta

# ===== 站点 =====
# 监听端口
PORT=3000
# session 加密密钥,部署前改成一串随机长字符串
SESSION_SECRET=change-me-to-a-long-random-string

# 仅在 HTTPS 已由反向代理终止后设为 true；HTTP 裸部署保持 false，避免浏览器将静态资源错误升级为 https。
HTTPS_HARDENING=false

# ===== 首次启动自动创建的管理员账号 =====
# 仅在 data/accounts.json 不存在时生效
ADMIN_USER=admin
ADMIN_PASS=admin123
